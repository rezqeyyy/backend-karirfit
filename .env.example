# LLM (optional). Without keys: dictionary extraction + template explanations.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Next.js origin(s), comma separated
ALLOWED_ORIGINS=http://localhost:3000

# 1 = public mode (private RPS chunks never retrieved)
PUBLIC_MODE=1
RAG_TOP_K=5
RAG_THRESHOLD=0.80

# 1 during the user evaluation: A/B ranking comparison, SUS, non-RAG twin explanations (Sections 3.6.4-3.6.6)
EVAL_MODE=0
EVAL_SECRET=

# enables GET /api/export and /api/admin/* with header X-Admin-Token
ADMIN_TOKEN=
DB_PATH=karirfit.db
# On Render set DATABASE_URL (Render Postgres); otherwise the local SQLite file above is used
DATABASE_URL=
