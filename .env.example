# LLM (optional). Without keys: dictionary extraction + template explanations.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=            # career assistant chat (POST /api/chat); also the explanation fallback
GROQ_MODEL=openai/gpt-oss-120b

# Next.js origin(s), comma separated
ALLOWED_ORIGINS=http://localhost:3000

# 1 = public mode (private RPS chunks never retrieved)
PUBLIC_MODE=1
RAG_TOP_K=5
RAG_THRESHOLD=0.80

# 1 during the user evaluation: A/B ranking comparison, SUS, non-RAG twin explanations (Sections 3.6.4-3.6.6)
EVAL_MODE=0
EVAL_SECRET=

# enables GET /api/export and /api/admin/* with header X-Admin-Token
ADMIN_TOKEN=
DB_PATH=karirfit.db
# Supabase Postgres for the evaluation log (Supabase -> Project Settings -> Database -> Connection string,
# "Transaction pooler", URI). Empty = local SQLite file above.
DATABASE_URL=

# Supabase Auth: the API accepts only logged-in users (Authorization: Bearer <access token>)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=
REQUIRE_AUTH=1
